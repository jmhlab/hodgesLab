---
layout: base.njk
title: Research
permalink: /research/
---
<section class="page-head page-head-slim">
  <div>
    <div class="kicker">Research</div>
    <h1>Making solids that don't exist&nbsp;yet.</h1>
  </div>
</section>

<section class="themes">
{% for t in research.themes %}
{% set block = site.about | find("key", t.key) %}
  <article class="theme" id="{{ t.key }}">
    <h2 class="theme-title">{{ block.heading }}</h2>
    {% for para in block.body | trim | split("\n\n") %}<p>{{ para | replace("\n", " ") | em | safe }}</p>{% endfor %}
  </article>
{% endfor %}
</section>
