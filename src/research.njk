---
layout: base.njk
title: Research
permalink: /research/
structuresOnPage: true
---
<section class="page-head page-head-slim">
  <div>
    <div class="kicker">Research</div>
    <h1>Making solids that don't exist&nbsp;yet.</h1>
  </div>
  <p class="intro">{{ research.intro | trim }}</p>
</section>

<section class="rgrid">
{% for a in research.areas %}
{% set st = structures[a.structure] %}
{% set paper = publications | find("n", a.paper) %}
  <article class="rcard" id="{{ a.id }}">
    <div class="rcard-media">
      {% if st %}
      <div class="structure" data-structure="{{ st.file }}" data-view="{{ st.view }}" data-ortho="{{ st.ortho }}" data-spin="{{ st.spin }}" data-alpha="{{ st.alpha or 0.85 }}" data-scale="{{ st.scale or '' }}" data-cell="0" data-fit="1.3" data-structure-alt="{{ st.alt or '' }}" data-labels="{{ st.labels or '' }}" data-hold="{{ st.hold or 4 }}" data-fade="{{ st.fade or 1.2 }}" aria-label="{{ st.label }}"></div>
      {% elif a.image %}<img src="{{ ('/assets/img/' ~ a.image) | url }}" alt="{{ a.title }}" loading="lazy">{% endif %}
    </div>
    {% if a.caption %}<div class="rcard-cap">{{ a.caption }}</div>{% endif %}
    <h2 class="rcard-title">{{ a.title }}</h2>
    <p class="rcard-text">{{ a.long | trim | replace("\n", " ") }}</p>
    {% if paper %}
    <a class="rcard-paper" href="{{ paper.url or ('https://doi.org/' ~ paper.doi) }}"><span class="rcard-paper-k">Read</span> {{ paper.title | chem | safe }} <span class="rcard-paper-j"><em>{{ paper.journal }}</em> {{ paper.year }}</span></a>
    {% endif %}
  </article>
{% endfor %}
</section>
