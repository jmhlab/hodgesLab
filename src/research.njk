---
layout: base.njk
title: Research
permalink: /research/
---
<section class="page-head page-head-slim research-lead{% if research.lead_photo or research.lead_photos %} has-photo{% endif %}">
  {% if research.lead_photos and research.lead_photos | length %}<div class="lead-bg lead-bg-grid" aria-hidden="true">{% for f in research.lead_photos %}<img src="{{ ('/assets/img/hero/' ~ f) | url }}" alt="">{% endfor %}</div>
  {% elif research.lead_photo %}<div class="lead-bg" aria-hidden="true"><img src="{{ ('/assets/img/hero/' ~ research.lead_photo) | url }}" alt="" style="object-position: {{ research.lead_photo_focus or '50% 50%' }};"></div>{% endif %}
  {% for para in research.intro | trim | split("\n\n") %}<p class="lead{% if loop.first %} lead-first{% endif %}">{{ para | replace("\n", " ") }}</p>{% endfor %}
</section>

{% if research.projects %}
<section class="projects">
  <h2 class="section-title">What we work on</h2>
  {% for pr in research.projects %}
  <article class="project">
    <div class="project-text">
      <h3 class="project-title">{{ pr.title }}</h3>
      {% for para in pr.body | trim | split("\n\n") %}<p>{{ para | replace("\n", " ") | chem | safe }}</p>{% endfor %}
      {% if pr.link %}<a class="project-link" href="{{ pr.link }}">Read the paper →</a>{% endif %}
    </div>
    {% if pr.image %}<a class="project-media" href="{{ pr.link or '#' }}"><img src="{{ ('/assets/img/toc/' ~ pr.image) | url }}" alt="" loading="lazy"></a>{% endif %}
  </article>
  {% endfor %}
</section>
{% endif %}
