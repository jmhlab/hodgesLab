---
layout: base.njk
title: Publications
permalink: /publications/
---
<section class="page-head page-head-slim page-head-pubs">
  <div>
    <h1>Publications</h1>
  </div>
</section>

{% macro paper(p) %}
<article class="pub{% if p.toc %} has-toc{% endif %}">
  {% if p.toc %}<a class="pub-toc" href="{{ p.url or ('https://doi.org/' ~ p.doi) }}"><img src="{{ ('/assets/img/toc/' ~ p.toc) | url }}" alt="" loading="lazy"></a>{% endif %}
  <div class="pub-body">
    {% if p.n %}<span class="pub-n">{{ p.n }}.</span> {% endif %}{% if p.doi or p.url %}<a class="pub-title" href="{{ p.url or ('https://doi.org/' ~ p.doi) }}">{{ p.title | chem | safe }}</a>{% else %}<span class="pub-title">{{ p.title | chem | safe }}</span>{% endif %}. <span class="pub-authors">{{ p.authors | boldMembers(site.member_names) | safe }}</span> <span class="pub-ref"><em>{{ p.journal }}</em>{% if p.status %} {{ p.status }}{% endif %}{% if p.year %} <b>{{ p.year }}</b>{% endif %}{% if p.volume %}, {{ p.volume }}{% endif %}{% if p.pages %}, {{ p.pages }}{% endif %}.</span>
  </div>
</article>
{% endmacro %}

<section class="pubs" id="papers">
  {% set preprints = publications | where("era", "preprint") %}
  {% if preprints | length %}
  <div class="pub-divider"><span>Preprints (in review)</span></div>
  {% for p in preprints %}{{ paper(p) }}{% endfor %}
  <div class="pub-divider"><span>Publications</span></div>
  {% endif %}

  {% for p in publications | where("era", "psu") %}{{ paper(p) }}{% endfor %}

  <div class="pub-divider"><span>Prior to Penn State</span></div>

  {% for p in publications | where("era", "earlier") %}{{ paper(p) }}{% endfor %}
</section>

<section class="pubs patents" id="patents">
  <div class="pub-divider"><span>Patents and applications</span></div>
  {% for p in patents %}
  <article class="pub">
    <div class="pub-body">
      <div class="pub-n">P{{ p.n }}</div>
      <h2 class="pub-title">{{ p.title }}</h2>
      <div class="pub-authors">{{ p.inventors | boldMembers(site.member_names) | safe }}</div>
      <div class="pub-ref">{{ p.number }}, {{ p.year }}</div>
    </div>
  </article>
  {% endfor %}
</section>
