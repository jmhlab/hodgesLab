---
layout: base.njk
title: People
permalink: /people/
---
{% macro panel(p, line) %}
<div class="panel">
  <div class="panel-photo{% if not p.photo %} ph{% endif %}">{% if p.photo %}<img src="{{ ('/assets/img/team/' ~ p.photo) | url }}" alt="{{ p.name }}" loading="lazy" onerror="this.parentNode.classList.add('ph'); this.remove();">{% endif %}</div>
  <div class="panel-name">{{ p.name }}</div>
  <div class="panel-line">{{ line | safe }}</div>
</div>
{% endmacro %}

<section class="page-head page-head-slim">
  <div>
    <div class="kicker">People</div>
    <h1>The group.</h1>
  </div>
</section>

{% set pi = team.pi %}
<section class="pp-section">
  <h2 class="eyebrow">Principal investigator</h2>
  <div class="pp pp-pi">
    <div class="pp-photo{% if not pi.photo %} ph{% endif %}">{% if pi.photo %}<img src="{{ ('/assets/img/team/' ~ pi.photo) | url }}" alt="{{ pi.name }}">{% endif %}</div>
    <div class="pp-text">
      <div class="pp-name">{{ pi.name }}</div>
      <div class="pp-line">{{ pi.title }}, {{ pi.institution }}</div>
      <div class="pp-line"><a href="mailto:{{ pi.email }}">{{ pi.email }}</a>{% for l in pi.links %} · <a href="{{ l.url }}">{{ l.label }}</a>{% endfor %}</div>
      {% for para in pi.bio | trim | split("\n\n") %}<p class="pp-bio">{{ para | replace("\n", " ") }}</p>{% endfor %}
    </div>
  </div>
</section>

<section class="pp-section">
  <h2 class="eyebrow">Graduate students</h2>
  <div class="panels">
    {% for p in team.graduate | byTenure %}{% set bits = [] %}{% if p.degree %}{% set bits = (bits.push(p.degree), bits) %}{% endif %}{% if p.joined %}{% set bits = (bits.push('Joined ' ~ p.joined), bits) %}{% endif %}{{ panel(p, bits | join('<br>')) }}{% endfor %}
  </div>
</section>

<section class="pp-section">
  <h2 class="eyebrow">Undergraduate students</h2>
  <div class="panels">
    {% for p in team.undergraduate | byTenure %}{% set bits = [] %}{% if p.major %}{% set bits = (bits.push(p.major), bits) %}{% endif %}{% if p.joined %}{% set bits = (bits.push('Joined ' ~ p.joined), bits) %}{% endif %}{{ panel(p, bits | join('<br>')) }}{% endfor %}
  </div>
</section>

<section class="pp-section pp-alumni">
  <h2 class="eyebrow">Alumni</h2>
  {% if team.alumni.graduate | length %}
  <h3 class="pp-alumni-h">Graduate students</h3>
  <div class="pp-alumni-list">
    {% for a in team.alumni.graduate | byYears %}<div class="pp-alumni-row"><span class="who">{{ a.name }}</span><span class="what">{{ a.degree or 'Graduate student' }}, {{ a.years }}{% if a.now %} → {{ a.now }}{% endif %}</span></div>{% endfor %}
  </div>
  {% endif %}
  {% if team.alumni.undergraduate | length %}
  <h3 class="pp-alumni-h">Undergraduate students</h3>
  <div class="pp-alumni-list">
    {% for a in team.alumni.undergraduate | byYears %}<div class="pp-alumni-row"><span class="who">{{ a.name }}</span><span class="what">Undergraduate researcher, {{ a.years }}{% if a.now %} → {{ a.now }}{% endif %}</span></div>{% endfor %}
  </div>
  {% endif %}
  {% if team.alumni.postdocs | length %}
  <h3 class="pp-alumni-h">Postdoctoral researchers</h3>
  <div class="pp-alumni-list">
    {% for a in team.alumni.postdocs | byYears %}<div class="pp-alumni-row"><span class="who">{{ a.name }}</span><span class="what">Postdoctoral researcher, {{ a.years }}{% if a.now %} → {{ a.now }}{% endif %}</span></div>{% endfor %}
  </div>
  {% endif %}
</section>
